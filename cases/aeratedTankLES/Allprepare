#!/usr/bin/env bash
# Usage: ./cases/aeratedTankLES/Allprepare /absolute/new/run [exercise|smoke] [ranks]
# Creates an independent LES-MRF case. Never modifies the RANS template/run.
# exercise: candidate refined grid; smoke: cheaper integration test grid only.
set -euo pipefail
here=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
target=${1:?Usage: Allprepare /absolute/new/run [exercise|smoke] [ranks]}
profile=${2:-exercise}
ranks=${3:-8}
[[ $# -le 3 && $profile =~ ^(exercise|smoke)$ && $ranks =~ ^[1-9][0-9]*$ ]] || {
    echo 'Expected profile exercise|smoke and a positive MPI rank count.' >&2; exit 2;
}
"$here/../aeratedTank/Allprepare" "$target"
cp "$here/constant/"* "$target/constant/"
cp "$here/Allmesh" "$target/"
printf '%s\n' "$profile" > "$target/les-mesh-profile"
foamDictionary "$target/system/decomposeParDict" -entry numberOfSubdomains -set "$ranks"
# Keep decomposition independent of optional Scotch/Metis installations.
foamDictionary "$target/system/decomposeParDict" -entry method -set hierarchical
foamDictionary "$target/system/decomposeParDict" -entry hierarchicalCoeffs \
    -set "{ n (1 1 $ranks); order xyz; }"
foamDictionary "$target/system/controlDict" -entry deltaT -set 0.0001
foamDictionary "$target/system/controlDict" -entry writeInterval -set 0.1
# BDF2 for supported flow equations; phase-fraction MULES remains Euler-based
# internally in OF13. Oxygen uses the coupled midpoint method in this library.
foamDictionary "$target/system/fvSchemes" -entry ddtSchemes -set '{ default backward; }'
foamDictionary "$target/constant/bioProperties" -entry oxygenIntegration -set midpoint
foamDictionary "$target/system/fvSchemes" -entry 'gradSchemes/grad(U)' -set 'Gauss linear'
foamDictionary "$target/system/fvSchemes" -entry 'divSchemes/div(alphaRhoPhi,U)' -set 'Gauss linear'
foamDictionary "$target/system/fvSchemes" -entry 'divSchemes/div(phi,U)' -set 'Gauss linear'
foamDictionary "$target/system/fvSchemes" -entry 'divSchemes/div(alphaPhi.liquid,oxygen.liquid)' -set 'Gauss limitedLinear 1'
foamDictionary "$target/system/fvSchemes" -entry 'laplacianSchemes/laplacian(oxygenDiffusivity,oxygen.liquid)' -set 'Gauss linear corrected'
foamDictionary "$target/system/fvSolution" -entry PIMPLE/nOuterCorrectors -set 2
foamDictionary "$target/system/fvSolution" -entry PIMPLE/nNonOrthogonalCorrectors -set 1
# The tutorial uses system/functions, which takes precedence over controlDict.
# Keep its existing diagnostics, add LES fields, and put the stop trigger there.
foamDictionary "$target/system/controlDict" -entry functions -remove
cat >> "$target/system/functions" <<'FUNCTIONS'

lesYPlus
{
    type yPlus;
    libs ("libfieldFunctionObjects.so");
    phase liquid;
    executeControl timeStep;
    executeInterval 1;
    writeControl writeTime;
}
lesCellVolumes
{
    type writeCellVolumes;
    libs ("libfieldFunctionObjects.so");
    writeControl writeTime;
}
lesCellCentres
{
    type writeCellCentres;
    libs ("libfieldFunctionObjects.so");
    writeControl writeTime;
}
abort
{
    type stopAtFile;
    libs ("libutilityFunctionObjects.so");
    file "$FOAM_CASE/abort";
    action nextWrite;
    executeControl timeStep;
    executeInterval 1;
}
FUNCTIONS
# The upstream MRF and shaft BCs include this shared file. Match the initial
# controller command before solver construction, avoiding an artificial first
# flux-frame conversion from the tutorial's 500 rpm to the ramp's zero speed.
foamDictionary "$target/constant/rotatingZoneProperties" -entry omega -set 0
# Start from rest, ramp to 500 rpm, then introduce aeration. A discontinuous
# full-speed/full-flow start can produce nonphysical pressure transients.
foamDictionary "$target/constant/bioProperties" -entry controller -set prescribed
foamDictionary "$target/constant/bioProperties" -entry initialOmega -set '[0 0 -1 0 0 0 0] 0'
foamDictionary "$target/constant/bioProperties" -entry initialGasFlow -set '[0 3 -1 0 0 0 0] 0'
foamDictionary "$target/constant/bioProperties" -entry schedule -set '((0 0 0)(6 52.35987755982988 0)(6.1 52.35987755982988 0.0186666666666667)(60 52.35987755982988 0.0186666666666667))'
cat >> "$target/constant/bioProperties" <<'NUMERICS'

// LES numerics: oxygenIntegration midpoint couples transport and reactions.
// Second-order oxygen time discretisation for smooth, time-centred flow inputs;
// upstream Euler-based phase transport still limits full-system temporal order.
// Midpoint is not unconditionally positive: reduce deltaT if positivity fails.
NUMERICS
# Retain official wall functions as an initial wall-modelled treatment.
# k.gas is needed by continuousGasKEqn; k.liquid remains for wall-function input.
# omega belongs to the former RANS closure, and is not solved by either LES model.
rm -f -- "$target/0/omega.gas" "$target/0/omega.liquid" \
    "$target/0.backup/omega.gas" "$target/0.backup/omega.liquid"
echo "Prepared LES-MRF $profile case: $target"
echo 'Run ./Allmesh then ./Allrun. Check local Courant number, y+ and grid sensitivity.'
