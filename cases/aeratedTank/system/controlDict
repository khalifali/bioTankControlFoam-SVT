FoamFile
{
    format              ascii;
    class               dictionary;
    object              controlDict;
}

// Transient control experiments need time accuracy, not only steady convergence.

// ---------------------------------------------------------------------------
// 1. Solver selection
// ---------------------------------------------------------------------------

libs                ("libbioTankControlFoam.so");
solver              bioTankControlFoam;

// ---------------------------------------------------------------------------
// 2. Simulation interval and time step
// ---------------------------------------------------------------------------

startFrom           startTime;
startTime           0;
stopAt              endTime;
endTime             60;
deltaT              0.001;
adjustTimeStep      no;

// ---------------------------------------------------------------------------
// 3. Output frequency and format
// ---------------------------------------------------------------------------

writeControl        runTime;
writeInterval       1;
writeFormat         ascii;
writePrecision      12;
writeCompression    off;
timeFormat          general;
timePrecision       10;

// ---------------------------------------------------------------------------
// 4. Runtime dictionary handling and retention
// ---------------------------------------------------------------------------

runTimeModifiable   false;
purgeWrite          0;

// ---------------------------------------------------------------------------
// 5. Save and stop using the abort file
// ---------------------------------------------------------------------------

// GRACEFUL STOP: while the solver is running, create "abort" in the case root.
// Save and exit at the next scheduled output time, not immediately.
// Old trigger files are removed at solver startup; create it AFTER startup.
functions
{
    abort
    {
        type                stopAtFile;
        libs                ("libutilityFunctionObjects.so");
        file                "$FOAM_CASE/abort";
        action              nextWrite;
        executeControl      timeStep;
        executeInterval     1;
    }
}

